# Copy to .env and fill in your own published-CSV URLs.
# Get each one from: Google Sheets -> File -> Share -> Publish to web
#   -> pick the single tab -> format "Comma-separated values (.csv)" -> Publish
# Keep .env out of git (it is already in .gitignore).
SHEET_CSV_PROJECTS=
SHEET_CSV_SKILLS=
SHEET_CSV_CERTS=
